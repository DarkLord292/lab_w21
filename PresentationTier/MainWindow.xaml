<Window x:Class="PresentationTier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="480" Width="720"
        WindowStartupLocation="CenterScreen" Background="AliceBlue">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Студенты" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
            <ListBox Name="MainList"
                     ItemsSource="{Binding Students}"
                     DisplayMemberPath="Display"
                     Margin="6"/>
        </GroupBox>

        <GroupBox Header="Выбранный студент" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                  DataContext="{Binding ElementName=MainList, Path=SelectedItem}">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ФИО:" Margin="0,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Fio}" Margin="4" IsReadOnly="True"/>

                <TextBlock Grid.Row="1" Text="Группа:" Margin="0,4"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Group}" Margin="4" IsReadOnly="True"/>

                <TextBlock Grid.Row="2" Text="Курс:" Margin="0,4"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Course}" Margin="4" IsReadOnly="True"/>

                <TextBlock Grid.Row="3" Text="Задолженности:" Margin="0,4"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Debts}" Margin="4" IsReadOnly="True"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Задолженности по курсам" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <ListBox ItemsSource="{Binding DebtsByCourse}"
                     DisplayMemberPath="Display" Height="80" Margin="6"/>
        </GroupBox>
        
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
            <TextBlock Text="Студентов без задолженностей: " FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StudentsWithoutDebts}" FontSize="16" FontWeight="Bold"
                       Foreground="DarkGreen" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>